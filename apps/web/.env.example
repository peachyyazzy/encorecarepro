# Supabase — get these from your project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. NEVER expose. Used by /api routes to bypass RLS for claims & invoices.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe — private-pay checkout
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Maps — Places autocomplete + distance matrix for mileage
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
GOOGLE_MAPS_SERVER_KEY=AIza...

# Clearinghouse — pick one when contracting
CLEARINGHOUSE_PROVIDER=office_ally
CLEARINGHOUSE_API_KEY=
CLEARINGHOUSE_SUBMITTER_ID=

# Organization defaults — printed on every invoice / superbill PDF + 837P claim
ORG_LEGAL_NAME="Encore Care NEMT"
ORG_DBA=
ORG_ADDRESS_LINE1="1 Encore Way"
ORG_CITY="New York"
ORG_STATE="NY"
ORG_POSTAL_CODE="10001"
ORG_PHONE="(555) 555-0100"
ORG_EMAIL="billing@encorecare.org"
ORG_NPI=
ORG_TAX_ID=

# Cron — Vercel Cron sends this in the Authorization header. Generate with:
#   openssl rand -base64 32
CRON_SECRET=
# How many days ahead to materialize recurring trips (default 30)
CRON_HORIZON_DAYS=30
