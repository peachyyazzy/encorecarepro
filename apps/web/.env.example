# Supabase — get these from your project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. NEVER expose. Used by /api routes to bypass RLS for claims & invoices.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe — private-pay checkout
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Maps — Places autocomplete + distance matrix for mileage
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
GOOGLE_MAPS_SERVER_KEY=AIza...

# Clearinghouse — pick one when contracting
CLEARINGHOUSE_PROVIDER=office_ally
CLEARINGHOUSE_API_KEY=
CLEARINGHOUSE_SUBMITTER_ID=

# Organization defaults — appears on invoices / claims
ORG_LEGAL_NAME="Encore Care NEMT"
ORG_NPI=
ORG_TAX_ID=
