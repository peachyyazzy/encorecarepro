EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Maps key — restrict to iOS bundle ID and Android package name in Google Cloud Console
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
# Base URL for the Next.js backend (Distance Matrix + trips + payments API)
EXPO_PUBLIC_API_URL=http://localhost:3000
# Stripe — publishable key is safe to ship on device
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Apple Pay merchant identifier (matches entitlements; e.g. merchant.org.encorecare.app)
EXPO_PUBLIC_APPLE_MERCHANT_ID=merchant.org.encorecare.app
